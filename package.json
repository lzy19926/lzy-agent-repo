{
  "name": "@lzy19926/agent-repo",
  "version": "1.0.0",
  "description": "极简Agent构建框架，支持多Agent切换、多Agent通信、技能扩展、工具调用和持久化记忆的CLI工具",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "agent": "./bin/agent.js",
    "lzy-agent": "./bin/agent.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "agent",
    "ai",
    "llm",
    "cli",
    "多Agent",
    "智能助手",
    "大模型"
  ],
  "author": "lzy19926",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/lzy19926/lzy-agent-repo.git"
  },
  "homepage": "https://github.com/lzy19926/lzy-agent-repo#readme",
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "front-matter": "^4.0.2",
    "openai": "^6.34.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}